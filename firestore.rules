rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones Helper ─────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'admin@gestor.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'admin@gestor.com' || 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)));
    }
    function isCobrador() {
      return isAuthenticated() && userRole() == 'cobrador';
    }
    function isAssignedCollector(clientData) {
      return request.auth.uid in clientData.assignedCollectorIds;
    }
    function canViewAllClientPayments() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canViewAllClientPayments == true;
    }

    // ── /users ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // ── /clients ──────────────────────────────────────────────────────
    match /clients/{clientId} {
      allow read: if isAdmin() || (isCobrador() && isAssignedCollector(resource.data));
      allow create, update: if isAdmin();
      allow delete: if false; 
    }

    // ── /credits/{creditId} ───────────────────────────────────────────
    match /credits/{creditId} {
      // El cobrador solo puede leer créditos donde su UID está en assignedCollectorIds
      allow read: if isAuthenticated() && (isAdmin() || (isCobrador() && request.auth.uid in resource.data.assignedCollectorIds));
      allow create: if isAdmin();
      allow delete: if false; 
      allow update: if isAdmin() || (isCobrador() && request.auth.uid in resource.data.assignedCollectorIds);

      // Cuotas
      match /installments/{installmentId} {
        allow read: if isAdmin() || (isCobrador() && request.auth.uid in get(/databases/$(database)/documents/credits/$(creditId)).data.assignedCollectorIds);
        allow create: if isAdmin();
        allow delete: if false; 
        allow update: if isAdmin() || (isCobrador() && request.auth.uid in get(/databases/$(database)/documents/credits/$(creditId)).data.assignedCollectorIds);
      }

      // Pagos — Reglas Locales
      match /payments/{paymentId} {
        allow read: if isAdmin() || 
                    (isCobrador() && resource.data.registeredByUid == request.auth.uid) ||
                    (isCobrador() && canViewAllClientPayments() && request.auth.uid in get(/databases/$(database)/documents/credits/$(creditId)).data.assignedCollectorIds);
        allow create: if isAdmin() || 
                      (isCobrador() && request.auth.uid in get(/databases/$(database)/documents/credits/$(creditId)).data.assignedCollectorIds);
        allow update: if isAdmin();
        allow delete: if isAdmin(); 
      }
    }

    // Regla global para consultas de grupo de colecciones (collection group queries)
    match /{path=**}/payments/{paymentId} {
      // Solo permite al cobrador leer globalmente SUS propios pagos
      allow read: if isAuthenticated() && (isAdmin() || (isCobrador() && resource.data.registeredByUid == request.auth.uid));
      allow create: if isAuthenticated() && (isAdmin() || isCobrador());
      allow update: if isAdmin();
      allow delete: if isAdmin(); 
    }

    // Regla global para consultas de grupo de cuotas (collection group queries)
    match /{path=**}/installments/{installmentId} {
      // Peligro de privacidad: Collection group de installments no se puede filtrar por cobrador fácilmente sin denormalizar.
      // Lo bloqueamos para cobradores. Deben usar consultas locales sub-colección.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow delete: if false; 
      allow update: if isAdmin();
    }

    // ── /appointments ─────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      // Debería limitarse al cobrador asignado
      allow read, create, update: if isAdmin() || (isCobrador() && resource.data.collectorId == request.auth.uid);
      allow delete: if false; 
    }

    // ── /appConfig ────────────────────────────────────────────────────
    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── /treasury ─────────────────────────────────────────────────────
    match /treasury/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isCobrador();
    }

    // ── /expenses ─────────────────────────────────────────────────────
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // ── /investments ──────────────────────────────────────────────────
    match /investments/{investmentId} {
      allow read, write: if isAdmin();

      // Pagos a inversores (subcolección)
      match /investor_payments/{paymentId} {
        allow read, write: if isAdmin();
      }
    }

    // Regla global para consultas de grupo de pagos de inversores (collection group queries)
    match /{path=**}/investor_payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // ── /cash_adjustments ─────────────────────────────────────────────
    match /cash_adjustments/{adjustmentId} {
      allow read, write: if isAdmin();
    }
  }
}
